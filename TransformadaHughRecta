package com.yoprogramo.transformadahughrecta;

import java.awt.*;
import java.awt.image.BufferedImage;
import javax.swing.*;


public class TransformadaHughRecta {

    public static void main(String[] args) {
        int width = 200;
        int height = 200;

        //Genera la imagen de prueba (matriz height x width de ceros = fondo negro)
        int[][] img = new int[height][width];
        for (int x = 20; x < 180; x++) {
            img[60][x] = 255;   // Recta horizontal en fila y = 60
            img[x][x] = 255;    // Recta diagonal (x = y)
        }

        //Definir el espacio de parámetros: theta de -90° a +90°, rho de -diag a +diag
        int diag = (int) Math.ceil(Math.hypot(width, height));
        int numRhos = 2 * diag + 1;
        int numThetas = 181; // De -90° a +90° inclusive

        //Construir el acumulador y votar (Paso 2: píxeles != 0)
        int[][] accumulator = new int[numRhos][numThetas];
        int maxVotos = 0;

        for (int y = 0; y < height; y++) {
            for (int x = 0; x < width; x++) {
                if (img[y][x] != 0) { // Paso 2: píxeles de borde
                    for (int tIdx = 0; tIdx < numThetas; tIdx++) {
                        double theta = Math.toRadians(tIdx - 90); // -90° a +90°
                        double rho = x * Math.cos(theta) + y * Math.sin(theta);
                        int rIdx = (int) Math.round(rho) + diag;

                        accumulator[rIdx][tIdx]++;
                        if (accumulator[rIdx][tIdx] > maxVotos) {
                            maxVotos = accumulator[rIdx][tIdx];
                        }
                    }
                }
            }
        }

        // Preparar imagen visual (fondo negro + bordes blancos)
        BufferedImage visImg = new BufferedImage(width, height, BufferedImage.TYPE_INT_RGB);
        for (int y = 0; y < height; y++) {
            for (int x = 0; x < width; x++) {
                if (img[y][x] == 255) visImg.setRGB(x, y, Color.WHITE.getRGB());
            }
        }

        //Detección de picos (> umbral) y dibujo de rectas 
        int threshold = 100;
        Graphics2D g = visImg.createGraphics();
        g.setColor(Color.RED);

        System.out.println("=== RECTAS DETECTADAS ===");
        for (int rIdx = 0; rIdx < numRhos; rIdx++) {
            for (int tIdx = 0; tIdx < numThetas; tIdx++) {
                if (accumulator[rIdx][tIdx] > threshold) {
                    int rho = rIdx - diag;
                    int thetaDeg = tIdx - 90;
                    double theta = Math.toRadians(thetaDeg);

                    System.out.printf("Recta -> rho: %d | theta: %d° | votos: %d%n",
                            rho, thetaDeg, accumulator[rIdx][tIdx]);

                    // Ecuación: x*cos(theta) + y*sin(theta) = rho
                    double cos = Math.cos(theta), sin = Math.sin(theta);
                    double x0 = cos * rho, y0 = sin * rho;
                    int x1 = (int) Math.round(x0 + 1000 * (-sin));
                    int y1 = (int) Math.round(y0 + 1000 * cos);
                    int x2 = (int) Math.round(x0 - 1000 * (-sin));
                    int y2 = (int) Math.round(y0 - 1000 * cos);
                    g.drawLine(x1, y1, x2, y2);
                }
            }
        }
        g.dispose();

        //Construir imagen 2D del acumulador (rho vs theta) normalizada a 0-255
        BufferedImage accImg = new BufferedImage(numThetas, numRhos, BufferedImage.TYPE_BYTE_GRAY);
        for (int r = 0; r < numRhos; r++) {
            for (int t = 0; t < numThetas; t++) {
                int gris = (int) ((accumulator[r][t] * 255.0) / maxVotos);
                int rgb = (gris << 16) | (gris << 8) | gris;
                accImg.setRGB(t, r, rgb);
            }
        }

        // Mostrar ambas imágenes 
        JPanel panel = new JPanel(new FlowLayout(FlowLayout.CENTER, 15, 10));
        panel.add(crearBloque("Imagen + Rectas Detectadas", visImg, width, height));
        panel.add(crearBloque("Acumulador (rho vs theta)", accImg, 220, height));

        JOptionPane.showMessageDialog(null, panel, "Transformada de Hough - Prototipo", JOptionPane.PLAIN_MESSAGE);
    }

    private static JPanel crearBloque(String titulo, BufferedImage img, int w, int h) {
        JPanel p = new JPanel(new BorderLayout());
        Image escalada = img.getScaledInstance(w, h, Image.SCALE_SMOOTH);
        p.add(new JLabel(titulo, SwingConstants.CENTER), BorderLayout.NORTH);
        p.add(new JLabel(new ImageIcon(escalada)), BorderLayout.CENTER);
        return p;
    }
}
